{
  "server": "fal",
  "description": "A fake fal MCP server: fal-ai/ideogram/v3 only. run_model completes at once with one 1312x736 PNG at https://v3.fal.media/files/lion/Hc7Vb2Nm5Qw8Er1Ty4Ui6.png. Bills nothing.",
  "tools": {
    "get_pricing": {
      "description": "Check model pricing before generation.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_ids": {
            "type": "string",
            "description": "comma-separated endpoint ids, up to 50"
          }
        },
        "required": [
          "endpoint_ids"
        ]
      },
      "answers": [
        {
          "when": {
            "endpoint_ids": "fal-ai/ideogram/v3"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"prices\":[{\"endpoint_id\":\"fal-ai/ideogram/v3\",\"unit_price\":0.03,\"unit\":\"image (TURBO); 0.06 BALANCED, 0.09 QUALITY\",\"currency\":\"USD\"}]}"
              }
            ]
          }
        }
      ],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"prices\":[{\"endpoint_id\":\"fal-ai/ideogram/v3\",\"unit_price\":0.03,\"unit\":\"image (TURBO); 0.06 BALANCED, 0.09 QUALITY\",\"currency\":\"USD\"}],\"note\":\"other endpoints are not served by this fake\"}"
          }
        ]
      }
    },
    "get_model_schema": {
      "description": "Get the full input/output schema for a specific model. Use this before run_model.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string"
          }
        },
        "required": [
          "endpoint_id"
        ]
      },
      "answers": [
        {
          "when": {
            "endpoint_id": "fal-ai/ideogram/v3"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"endpoint_id\":\"fal-ai/ideogram/v3\",\"input\":{\"type\":\"object\",\"properties\":{\"prompt\":{\"type\":\"string\"},\"image_size\":{\"default\":\"square_hd\",\"anyOf\":[{\"type\":\"object\"},{\"enum\":[\"square_hd\",\"square\",\"portrait_4_3\",\"portrait_16_9\",\"landscape_4_3\",\"landscape_16_9\"]}]},\"rendering_speed\":{\"enum\":[\"TURBO\",\"BALANCED\",\"QUALITY\"],\"default\":\"BALANCED\"},\"style\":{\"enum\":[\"AUTO\",\"GENERAL\",\"REALISTIC\",\"DESIGN\"]},\"num_images\":{\"type\":\"integer\",\"default\":1},\"enable_prompt_expansion\":{\"type\":\"boolean\",\"default\":true},\"negative_prompt\":{\"type\":\"string\",\"default\":\"\"},\"sync_mode\":{\"type\":\"boolean\",\"default\":false}}},\"output\":{\"type\":\"object\",\"properties\":{\"images\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"url\":{\"type\":\"string\"},\"width\":{\"type\":\"integer\"},\"height\":{\"type\":\"integer\"},\"content_type\":{\"type\":\"string\"}}}},\"seed\":{\"type\":\"integer\"}}}}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "unknown request for this fake: only fal-ai/ideogram/v3 is served"
          }
        ]
      }
    },
    "run_model": {
      "description": "Run a fal model through the queue. Waits up to 45 seconds; returns completed with the result or processing with a request ID and URLs to check the job. Another run_model call creates a new billable job.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "description": "Model parameters as JSON. Use get_model_schema to see accepted fields."
          },
          "expiration_seconds": {
            "type": "number"
          },
          "store_payload": {
            "type": "boolean"
          }
        },
        "required": [
          "endpoint_id",
          "input"
        ]
      },
      "answers": [
        {
          "when": {
            "endpoint_id": "fal-ai/ideogram/v3"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"status\":\"completed\",\"request_id\":\"e1f2a3b4-5c6d-4e7f-8a9b-0c1d2e3f4a5b\",\"endpoint_id\":\"fal-ai/ideogram/v3\",\"data\":{\"images\":[{\"url\":\"https://v3.fal.media/files/lion/Hc7Vb2Nm5Qw8Er1Ty4Ui6.png\",\"width\":1312,\"height\":736,\"content_type\":\"image/png\"}],\"seed\":902},\"recipe\":{\"endpoint_id\":\"fal-ai/ideogram/v3\",\"input_omitted\":true}}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "422: this server only runs fal-ai/ideogram/v3"
          }
        ]
      }
    },
    "check_job": {
      "description": "Check an existing job's status.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status_url": {
            "type": "string"
          }
        },
        "required": [
          "endpoint_id",
          "request_id"
        ]
      },
      "answers": [],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "unknown request for this fake: only fal-ai/ideogram/v3 is served"
          }
        ]
      }
    },
    "get_job_result": {
      "description": "Retrieve a completed job's output.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "response_url": {
            "type": "string"
          }
        },
        "required": [
          "endpoint_id",
          "request_id"
        ]
      },
      "answers": [],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "unknown request for this fake: only fal-ai/ideogram/v3 is served"
          }
        ]
      }
    }
  }
}
