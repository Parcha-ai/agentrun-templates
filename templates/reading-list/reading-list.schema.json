{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reading-list.schema.json",
  "title": "Weekly reading list",
  "description": "The week's top items from the reader's own feeds, ranked against their interests, none repeated from an earlier week.",
  "type": "object",
  "additionalProperties": false,
  "required": ["window", "interests", "quiet", "picks", "dropped_repeats", "feeds", "ignored_instructions", "report_markdown"],
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } }
    },
    "interests": { "type": "string", "maxLength": 600 },
    "quiet": { "type": "boolean", "description": "true when every feed was read and nothing in the window is worth a pick" },
    "picks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "title", "url", "feed", "published", "why", "matches"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "maxLength": 300, "description": "the item's title, as the feed gives it" },
          "url": { "type": "string", "format": "uri", "description": "the item's link, as the feed gives it" },
          "feed": { "type": "string", "description": "the feed URL it came from" },
          "published": { "type": "string", "description": "the item's date, as the feed gives it" },
          "why": { "type": "string", "minLength": 1, "maxLength": 320, "description": "at most two sentences: what it is about and why it fits the interests, from the feed's title and summary" },
          "matches": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 80 }, "description": "the interests it fits, in the reader's words" }
        }
      }
    },
    "dropped_repeats": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": { "title": { "type": "string", "maxLength": 300 }, "url": { "type": "string" } },
        "description": "an item in the window that an earlier run already picked"
      }
    },
    "feeds": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "status", "items_in_window"],
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string", "maxLength": 200 },
          "status": { "enum": ["read", "unreachable", "not_a_feed"] },
          "items_in_window": { "type": ["integer", "null"], "minimum": 0, "description": "null when the feed was not read (unreachable or not_a_feed): nothing was counted" },
          "note": { "type": "string", "maxLength": 300, "description": "for unreachable or not_a_feed: the error or what came back" }
        }
      }
    },
    "ignored_instructions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["where", "asked"],
        "properties": { "where": { "type": "string", "maxLength": 300 }, "asked": { "type": "string", "maxLength": 300 } }
      }
    },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "maxLength": 5000, "description": "the list for the reader: a numbered list, each pick's title linked, its feed and date, and its why; then any feed that could not be read" }
  }
}
