{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Buyer evidence pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["checked_on", "interpretation", "coverage", "objections", "against", "gaps", "do_next", "near_misses", "unreachable", "ignored_instructions", "report_markdown"],
  "properties": {
    "checked_on": { "type": "string", "format": "date" },
    "interpretation": { "type": "string", "maxLength": 400, "description": "How you read the inputs, in one line." },
    "coverage": { "type": "string", "maxLength": 400, "description": "One or two sentences on how well the objections are covered." },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objection", "buyer_words", "evidence", "talking_points", "question"],
        "properties": {
          "objection": { "type": "string", "minLength": 1, "description": "As listed." },
          "buyer_words": { "type": "string", "maxLength": 300, "description": "How this role would say it." },
          "evidence": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim", "context", "source", "url", "date", "segment_fit", "fit_reason", "independence"],
              "properties": {
                "claim": { "type": "string", "minLength": 1, "maxLength": 300, "description": "The figure or finding exactly as the source states it." },
                "context": { "type": "string", "maxLength": 300, "description": "Sample, segment, period, method, as the source gives them." },
                "source": { "type": "string", "minLength": 1, "maxLength": 160, "description": "The named customer or publisher." },
                "url": { "type": "string", "format": "uri" },
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
                "segment_fit": { "enum": ["strong", "partial", "weak"] },
                "fit_reason": { "type": "string", "maxLength": 200 },
                "independence": { "enum": ["vendor", "third_party"] }
              }
            }
          },
          "talking_points": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "maxLength": 300 },
            "description": "Each tied to an evidence row it names."
          },
          "question": { "type": ["string", "null"], "maxLength": 300, "description": "One question that uses a cited fact to draw out the buyer's own numbers; null when the objection has no evidence." }
        }
      }
    },
    "against": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objection", "finding", "source", "url", "date"],
        "properties": {
          "objection": { "type": "string" },
          "finding": { "type": "string", "maxLength": 300 },
          "source": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" }
        }
      },
      "description": "Evidence that cuts against the seller or contradicts a vendor claim."
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objection", "why", "what_would_close_it"],
        "properties": {
          "objection": { "type": "string" },
          "why": { "type": "string", "maxLength": 300, "description": "Thin, vendor-only, dated, off-segment, or nothing found, and where you looked." },
          "what_would_close_it": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "do_next": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 240 } },
    "near_misses": { "type": "array", "items": { "type": "string", "maxLength": 240 }, "description": "Leads you could not verify, with why." },
    "unreachable": { "type": "array", "items": { "type": "string", "maxLength": 240 } },
    "ignored_instructions": { "type": "array", "items": { "type": "string", "maxLength": 400 } },
    "report_markdown": { "type": "string", "minLength": 1, "contentMediaType": "text/markdown" }
  }
}
