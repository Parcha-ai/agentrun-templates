{
  "server": "fal",
  "description": "A fake fal MCP server: fal-ai/elevenlabs/tts/eleven-v3 only. run_model completes at once with one MP3 at https://v3.fal.media/files/zebra/Lp3Ok9Ij7Uh5Yg1Tf2Rd4_output.mp3. Bills nothing.",
  "tools": {
    "get_pricing": {
      "description": "Check model pricing before generation.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_ids": {
            "type": "string",
            "description": "comma-separated endpoint ids, up to 50"
          }
        },
        "required": [
          "endpoint_ids"
        ]
      },
      "answers": [
        {
          "when": {
            "endpoint_ids": "fal-ai/elevenlabs/tts/eleven-v3"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"prices\":[{\"endpoint_id\":\"fal-ai/elevenlabs/tts/eleven-v3\",\"unit_price\":0.1,\"unit\":\"1000 characters\",\"currency\":\"USD\"}]}"
              }
            ]
          }
        }
      ],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"prices\":[{\"endpoint_id\":\"fal-ai/elevenlabs/tts/eleven-v3\",\"unit_price\":0.1,\"unit\":\"1000 characters\",\"currency\":\"USD\"}],\"note\":\"other endpoints are not served by this fake\"}"
          }
        ]
      }
    },
    "get_model_schema": {
      "description": "Get the full input/output schema for a specific model. Use this before run_model.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string"
          }
        },
        "required": [
          "endpoint_id"
        ]
      },
      "answers": [
        {
          "when": {
            "endpoint_id": "fal-ai/elevenlabs/tts/eleven-v3"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"endpoint_id\":\"fal-ai/elevenlabs/tts/eleven-v3\",\"input\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":5000},\"voice\":{\"type\":\"string\",\"default\":\"Rachel\",\"examples\":[\"Aria\",\"Roger\",\"Sarah\",\"Laura\",\"Charlie\",\"George\",\"Callum\",\"River\",\"Liam\",\"Charlotte\",\"Alice\",\"Matilda\",\"Will\",\"Jessica\",\"Eric\",\"Chris\",\"Brian\",\"Daniel\",\"Lily\",\"Bill\"]},\"stability\":{\"type\":\"number\",\"default\":0.5,\"minimum\":0,\"maximum\":1},\"language_code\":{\"type\":[\"string\",\"null\"]},\"output_format\":{\"type\":\"string\",\"default\":\"mp3_44100_128\"},\"timestamps\":{\"type\":\"boolean\",\"default\":false}}},\"output\":{\"type\":\"object\",\"properties\":{\"audio\":{\"type\":\"object\",\"properties\":{\"url\":{\"type\":\"string\"},\"content_type\":{\"type\":\"string\"},\"file_size\":{\"type\":\"integer\"}}}}}}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "unknown request for this fake: only fal-ai/elevenlabs/tts/eleven-v3 is served"
          }
        ]
      }
    },
    "run_model": {
      "description": "Run a fal model through the queue. Waits up to 45 seconds; returns completed with the result or processing with a request ID and URLs to check the job. Another run_model call creates a new billable job.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "description": "Model parameters as JSON. Use get_model_schema to see accepted fields."
          },
          "expiration_seconds": {
            "type": "number"
          },
          "store_payload": {
            "type": "boolean"
          }
        },
        "required": [
          "endpoint_id",
          "input"
        ]
      },
      "answers": [
        {
          "when": {
            "endpoint_id": "fal-ai/elevenlabs/tts/eleven-v3"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"status\":\"completed\",\"request_id\":\"9f8e7d6c-5b4a-4392-8180-7f6e5d4c3b2a\",\"endpoint_id\":\"fal-ai/elevenlabs/tts/eleven-v3\",\"data\":{\"audio\":{\"url\":\"https://v3.fal.media/files/zebra/Lp3Ok9Ij7Uh5Yg1Tf2Rd4_output.mp3\",\"content_type\":\"audio/mpeg\",\"file_size\":412032}},\"recipe\":{\"endpoint_id\":\"fal-ai/elevenlabs/tts/eleven-v3\",\"input_omitted\":true}}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "422: this server only runs fal-ai/elevenlabs/tts/eleven-v3"
          }
        ]
      }
    },
    "check_job": {
      "description": "Check an existing job's status.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status_url": {
            "type": "string"
          }
        },
        "required": [
          "endpoint_id",
          "request_id"
        ]
      },
      "answers": [],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "unknown request for this fake: only fal-ai/elevenlabs/tts/eleven-v3 is served"
          }
        ]
      }
    },
    "get_job_result": {
      "description": "Retrieve a completed job's output.",
      "input": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "response_url": {
            "type": "string"
          }
        },
        "required": [
          "endpoint_id",
          "request_id"
        ]
      },
      "answers": [],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "unknown request for this fake: only fal-ai/elevenlabs/tts/eleven-v3 is served"
          }
        ]
      }
    }
  }
}
