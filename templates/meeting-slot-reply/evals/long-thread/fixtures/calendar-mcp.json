{
  "server": "googlecalendar",
  "description": "A fake Composio Google Calendar free/busy, Eastern (EST). Busy: Tue 8 9-17; Wed 9 9-12 and 13-15; Thu 10 10-16:30. The answer is the same whatever the arguments.",
  "tools": {
    "GOOGLECALENDAR_FREE_BUSY_QUERY": {
      "description": "Returns busy intervals for calendars between timeMin and timeMax (items: calendars by id).",
      "input": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array"
          },
          "timeMin": {
            "type": "string"
          },
          "timeMax": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "groupExpansionMax": {
            "type": "integer"
          },
          "calendarExpansionMax": {
            "type": "integer"
          }
        }
      },
      "answers": [],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{\"kind\":\"calendar#freeBusy\",\"timeMin\":\"2026-12-08T05:00:00.000Z\",\"timeMax\":\"2026-12-15T05:00:00.000Z\",\"calendars\":{\"primary\":{\"busy\":[{\"start\":\"2026-12-08T09:00:00-05:00\",\"end\":\"2026-12-08T17:00:00-05:00\"},{\"start\":\"2026-12-09T09:00:00-05:00\",\"end\":\"2026-12-09T12:00:00-05:00\"},{\"start\":\"2026-12-09T13:00:00-05:00\",\"end\":\"2026-12-09T15:00:00-05:00\"},{\"start\":\"2026-12-10T10:00:00-05:00\",\"end\":\"2026-12-10T16:30:00-05:00\"}]}}},\"successful\":true,\"error\":null}"
          }
        ]
      }
    }
  }
}
