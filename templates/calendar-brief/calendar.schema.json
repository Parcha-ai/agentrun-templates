{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calendar.schema.json",
  "title": "Calendar brief",
  "description": "The owner's meetings over the next days: each meeting in order, clashes, the prep each invite asks for, and a short public-web note on each outside company, with where it was posted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["window", "timezone", "meetings", "conflicts", "companies", "coverage", "delivery", "ignored_instructions", "report_markdown"],
  "$defs": {
    "link": { "type": "string", "format": "uri", "pattern": "^https://" }
  },
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } }
    },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "meetings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "title", "url", "status", "prep", "outside_domains", "conflict"],
        "properties": {
          "start": { "type": "string", "maxLength": 40, "description": "weekday, date and HH:MM in the owner's zone, or all-day" },
          "end": { "type": "string", "maxLength": 40 },
          "title": { "type": "string", "maxLength": 300 },
          "url": { "$ref": "#/$defs/link" },
          "status": { "enum": ["accepted", "organizer", "tentative", "not_answered", "all_day"] },
          "prep": { "type": ["string", "null"], "maxLength": 400, "description": "what the invite asks the owner to prepare, quoted short; null when it asks nothing" },
          "outside_domains": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 100 } },
          "conflict": { "type": "boolean" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["events", "overlap", "suggestion"],
        "properties": {
          "events": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "maxLength": 300 } },
          "overlap": { "type": "string", "maxLength": 80 },
          "suggestion": { "type": "string", "maxLength": 300, "description": "a suggestion only; nothing was answered or moved" }
        }
      }
    },
    "companies": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "name", "note", "sources", "found", "repeat"],
        "properties": {
          "domain": { "type": "string", "maxLength": 100 },
          "name": { "type": ["string", "null"], "maxLength": 200 },
          "note": { "type": "string", "minLength": 1, "maxLength": 600, "description": "1 to 3 sentences from the sources, or 'No public information found for <domain>.'" },
          "sources": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/link" } },
          "found": { "type": "boolean", "description": "false when nothing verifiable was found, or the domain is a personal-mail one" },
          "repeat": { "type": "boolean", "description": "true when the note was reused from a brief of the last 7 days rather than looked up again" },
          "noted_on": { "type": ["string", "null"], "format": "date", "description": "the day the note was looked up: today, or carried from the last brief when reused" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar", "events_read", "left_out"],
      "properties": {
        "calendar": { "enum": ["read", "failed"] },
        "events_read": { "type": "integer", "minimum": 0 },
        "left_out": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 300 }, "description": "declined or cancelled events, each with why" },
        "unreachable": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 300 } }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["via", "to", "status"],
      "properties": {
        "via": { "const": "slack" },
        "to": { "type": "string" },
        "status": { "enum": ["posted", "failed"] },
        "error": { "type": "string", "maxLength": 300 }
      }
    },
    "ignored_instructions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "maxLength": 6000, "description": "the brief as posted" }
  }
}
