      "description": "Search deals (filterGroups, properties, sorts, limit, after).",
      "input": {
        "type": "object",
        "properties": {
          "after": {
            "type": "string"
          },
          "filterGroups": {
            "type": "array"
          },
          "properties": {
            "type": "array"
          },
          "limit": {
            "type": "integer"
          },
          "sorts": {
            "type": "array"
          }
        }
      },
      "answers": [
        {
          "when": {
            "after": "100"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\":{\"total\":7,\"results\":[]},\"successful\":true,\"error\":null}"
              }
            ]
          }
        }
      ],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{\"total\":7,\"results\":[{\"id\":\"9001\",\"archived\":false,\"createdAt\":\"2026-08-01T10:00:00Z\",\"updatedAt\":\"2026-11-13T10:00:00Z\",\"properties\":{\"hs_object_id\":\"9001\",\"pipeline\":\"default\",\"dealname\":\"Globex expansion\",\"dealstage\":\"contractsent\",\"amount\":\"180000\",\"closedate\":\"2026-11-28T00:00:00Z\"}},{\"id\":\"9003\",\"archived\":false,\"createdAt\":\"2026-08-01T10:00:00Z\",\"updatedAt\":\"2026-11-13T10:00:00Z\",\"properties\":{\"hs_object_id\":\"9003\",\"pipeline\":\"default\",\"dealname\":\"Umbrella renewal\",\"dealstage\":\"decisionmakerboughtin\",\"amount\":\"95000\",\"closedate\":\"2026-12-01T00:00:00Z\"}},{\"id\":\"9004\",\"archived\":false,\"createdAt\":\"2026-08-01T10:00:00Z\",\"updatedAt\":\"2026-11-13T10:00:00Z\",\"properties\":{\"hs_object_id\":\"9004\",\"pipeline\":\"default\",\"dealname\":\"Hooli pilot\",\"dealstage\":\"qualifiedtobuy\",\"amount\":\"60500\",\"closedate\":\"2027-01-15T00:00:00Z\"}},{\"id\":\"9010\",\"archived\":false,\"createdAt\":\"2026-08-01T10:00:00Z\",\"updatedAt\":\"2026-11-13T10:00:00Z\",\"properties\":{\"hs_object_id\":\"9010\",\"pipeline\":\"default\",\"dealname\":\"Cyberdyne rollout\",\"dealstage\":\"presentationscheduled\",\"closedate\":\"2026-12-18T00:00:00Z\",\"amount\":null}},{\"id\":\"9011\",\"archived\":false,\"createdAt\":\"2026-08-01T10:00:00Z\",\"updatedAt\":\"2026-11-13T10:00:00Z\",\"properties\":{\"hs_object_id\":\"9011\",\"pipeline\":\"default\",\"dealname\":\"Tyrell renewal\",\"dealstage\":\"contractsent\",\"amount\":\"\",\"closedate\":\"2026-12-05T00:00:00Z\"}},{\"id\":\"9012\",\"archived\":false,\"createdAt\":\"2026-08-01T10:00:00Z\",\"updatedAt\":\"2026-11-13T10:00:00Z\",\"properties\":{\"hs_object_id\":\"9012\",\"pipeline\":\"default\",\"dealname\":\"Massive Dynamic\",\"dealstage\":\"decisionmakerboughtin\",\"amount\":\"\",\"closedate\":\"2027-01-10T00:00:00Z\"}},{\"id\":\"9006\",\"archived\":false,\"createdAt\":\"2026-08-01T10:00:00Z\",\"updatedAt\