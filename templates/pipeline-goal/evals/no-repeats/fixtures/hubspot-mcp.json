            "type": "array"
          },
          "limit": {
            "type": "integer"
          },
          "sorts": {
            "type": "array"
          }
        }
      },
      "answers": [
        {
          "when": {
            "after": "100"
          },
          "result": {
            "content": [
              {
                "type": "text",
