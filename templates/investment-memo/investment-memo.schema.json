{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investment-memo.schema.json",
  "title": "Investment memo first draft",
  "description": "A cited first-draft IC memo on one company. Every fact carries the ids of the sources it rests on (S1, S2, ...), each listed in `sources`; the company's own materials are source `M`. A figure no source shows is 'not found' and becomes a diligence question.",
  "type": "object",
  "additionalProperties": false,
  "required": ["checked_on", "company", "interpretation", "bottom_line", "thesis", "team", "market", "product", "traction", "competition", "deal", "risks", "diligence_questions", "do_next", "gaps", "sources", "report_markdown"],
  "properties": {
    "checked_on": { "$ref": "#/$defs/date" },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "website", "identity_note"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "legal_name": { "type": ["string", "null"] },
        "website": { "type": "string" },
        "headquarters": { "type": ["string", "null"] },
        "founded": { "type": ["string", "null"] },
        "identity_note": { "type": "string", "maxLength": 500, "description": "how the website fixed the entity, and any same-name company set aside" }
      }
    },
    "interpretation": { "type": "string", "maxLength": 500, "description": "defaults applied: the return bar used, the round the deal section rests on, the section order" },
    "bottom_line": { "type": "string", "minLength": 1, "maxLength": 600, "description": "what the company is, the deal, and the single biggest open question" },
    "thesis": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "maxLength": 400 }, "description": "up to three bullets, each a point for the partner to confirm, cited inline" },
    "team": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "background", "sources"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "background": { "type": "string", "maxLength": 300, "description": "professional history only" },
          "sources": { "$ref": "#/$defs/source_ids" }
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "estimates"],
      "properties": {
        "summary": { "type": "string", "maxLength": 800 },
        "estimates": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "value", "basis", "sources"],
            "properties": {
              "metric": { "type": "string", "maxLength": 200 },
              "value": { "type": ["string", "null"], "maxLength": 160 },
              "basis": { "enum": ["reported", "estimate", "calculation", "not_found"] },
              "method": { "type": ["string", "null"], "maxLength": 300, "description": "formula and inputs for a calculation" },
              "sources": { "$ref": "#/$defs/source_ids" }
            }
          }
        }
      }
    },
    "product": { "type": "string", "maxLength": 1000, "description": "what is sold, to whom, at what price, and what differs; cited inline" },
    "traction": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "value", "status", "sources"],
        "properties": {
          "metric": { "type": "string", "maxLength": 120 },
          "value": { "type": ["string", "null"], "maxLength": 160 },
          "status": { "enum": ["verified", "company_reported_consistent", "company_reported_inconsistent", "company_reported_unverifiable", "not_found"] },
          "note": { "type": ["string", "null"], "maxLength": 300, "description": "what public evidence says, for a consistent or inconsistent claim" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^(S[0-9]+|M)$" } }
        }
      }
    },
    "competition": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company", "relation", "sources"],
        "properties": {
          "company": { "type": "string" },
          "relation": { "type": "string", "maxLength": 200, "description": "direct competitor, adjacent, or valuation comp" },
          "stage": { "type": ["string", "null"], "maxLength": 60 },
          "last_valuation_or_multiple": { "type": ["string", "null"], "maxLength": 160, "description": "with its date, only from a source" },
          "sources": { "$ref": "#/$defs/source_ids" }
        }
      }
    },
    "deal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms_source", "summary"],
      "properties": {
        "terms_source": { "enum": ["input", "last_public_round", "none"] },
        "summary": { "type": "string", "maxLength": 800, "description": "entry valuation, ownership arithmetic and how the price compares to comps; 'not found' parts said so" },
        "post_money": { "type": ["string", "null"] },
        "ownership": { "type": ["string", "null"], "description": "the fund's check / post-money, with the arithmetic" }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "mitigant"],
        "properties": {
          "risk": { "type": "string", "maxLength": 300 },
          "mitigant": { "type": "string", "maxLength": 300, "description": "or 'none identified'" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^(S[0-9]+|M)$" } }
        }
      }
    },
    "diligence_questions": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "maxLength": 300 }, "description": "specific, answerable, each tied to a gap" },
    "do_next": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 240 } },
    "gaps": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 400 } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "found"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "published": { "type": ["string", "null"] },
          "found": { "type": "boolean" }
        }
      }
    },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "description": "the memo as Markdown, citing sources inline as [S1] and company materials as [M]" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source_ids": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]+$" } }
  }
}
