{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catch-up.schema.json",
  "title": "Team catch-up",
  "description": "What happened in the owner's Slack channels since the last catch-up: agreed decisions, unanswered requests to the owner and blockers, each linked, with what was dropped as already reported and where it was posted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["window", "items", "already_reported", "coverage", "delivery", "ignored_instructions", "report_markdown"],
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "maxLength": 40, "description": "RFC 3339 time the read started" },
        "to": { "type": "string", "maxLength": 40 }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 40,
      "description": "most urgent first",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "channel", "summary", "who", "owner", "status", "url", "update"],
        "properties": {
          "kind": { "enum": ["decision", "request", "blocker"] },
          "channel": { "type": "string", "maxLength": 20 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
          "who": { "type": "string", "maxLength": 200, "description": "who asked, decided or is blocked (a Slack member id or name)" },
          "owner": { "type": "string", "maxLength": 200, "description": "who the work is on, only when a message assigns or takes it; else unassigned" },
          "status": { "enum": ["open", "agreed", "proposed", "blocked", "cleared", "answered"] },
          "due": { "type": ["string", "null"], "maxLength": 60, "description": "only a deadline a message states" },
          "next_step": { "type": ["string", "null"], "maxLength": 300 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "quote": { "type": ["string", "null"], "maxLength": 200 },
          "update": { "type": "boolean", "description": "true when an earlier catch-up reported it and its status changed" }
        }
      }
    },
    "already_reported": {
      "type": "array",
      "maxItems": 100,
      "description": "permalinks seen again and left out because an earlier catch-up reported them unchanged",
      "items": { "type": "string", "maxLength": 300 }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels_read", "channels_not_read"],
      "properties": {
        "channels_read": { "type": "array", "maxItems": 10, "items": { "type": "string" } },
        "channels_not_read": { "type": "array", "maxItems": 10, "items": { "type": "string" } },
        "unread_since": { "type": "object", "maxProperties": 10, "additionalProperties": { "type": "string", "maxLength": 40 }, "description": "each channel not read this run, with the RFC 3339 time its unread stretch starts: where the next run reads it from" },
        "messages_read": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["via", "to", "status"],
      "properties": {
        "via": { "const": "slack" },
        "to": { "type": "string" },
        "status": { "enum": ["posted", "failed"] },
        "error": { "type": "string", "maxLength": 300 }
      }
    },
    "ignored_instructions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "maxLength": 6000, "description": "the catch-up as posted" }
  }
}
