{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "losses.schema.json",
  "title": "Stripe disputes and cancellations",
  "description": "The Stripe disputes and cancelled subscriptions new since the last run: disputes most urgent first with the evidence due date, cancellations with tenure, MRR lost and last payment, the one Slack post, and what was reported, carried so nothing is reported twice.",
  "x-carried": ["checked_through", "reported_disputes", "reported_cancellations"],
  "type": "object",
  "additionalProperties": false,
  "required": ["window", "disputes", "cancellations", "mrr_lost", "checked_through", "reported_disputes", "reported_cancellations", "posted", "limits", "ignored_instructions", "report_markdown"],
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "first_run": { "type": "boolean" }
      }
    },
    "disputes": {
      "type": "array",
      "maxItems": 100,
      "description": "most urgent first",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "amount", "reason", "status", "evidence_due", "days_left"],
        "properties": {
          "id": { "type": "string", "pattern": "^du_", "maxLength": 80 },
          "charge": { "type": ["string", "null"], "maxLength": 80 },
          "customer": { "type": ["string", "null"], "maxLength": 80, "description": "the name, or the customer ID when the name was set aside" },
          "amount": { "type": "string", "maxLength": 40, "description": "formatted, like $1,200.00" },
          "reason": { "type": "string", "maxLength": 60 },
          "status": { "type": "string", "maxLength": 40 },
          "evidence_due": { "type": ["string", "null"], "format": "date" },
          "days_left": { "type": ["integer", "null"], "description": "negative or 0 when overdue" },
          "overdue": { "type": "boolean" },
          "evidence_sent": { "type": "boolean" },
          "link": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "cancellations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "customer", "plan", "mrr", "tenure", "last_payment"],
        "properties": {
          "id": { "type": "string", "pattern": "^sub_", "maxLength": 80 },
          "customer": { "type": ["string", "null"], "maxLength": 80 },
          "plan": { "type": "string", "maxLength": 160 },
          "mrr": { "type": "string", "maxLength": 40, "description": "monthly revenue lost, formatted" },
          "tenure": { "type": "string", "maxLength": 40 },
          "canceled_on": { "type": "string", "format": "date" },
          "last_payment": { "type": "string", "maxLength": 80, "description": "amount and date, or never paid" },
          "why": { "type": ["string", "null"], "maxLength": 200 },
          "link": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "mrr_lost": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 }, "description": "total monthly revenue lost, one per currency" },
    "checked_through": { "type": "string", "format": "date-time", "pattern": "^[0-9T:.+Z-]{10,35}$", "maxLength": 35, "description": "the end of this run's window: the next run starts here" },
    "reported_disputes": {
      "type": "array",
      "maxItems": 500,
      "description": "dispute IDs reported in the last 90 days, oldest first",
      "items": { "type": "string", "pattern": "^du_[A-Za-z0-9_]{1,76}$", "maxLength": 80 }
    },
    "reported_cancellations": {
      "type": "array",
      "maxItems": 500,
      "description": "subscription IDs reported cancelled in the last 90 days, oldest first",
      "items": { "type": "string", "pattern": "^sub_[A-Za-z0-9_]{1,76}$", "maxLength": 80 }
    },
    "posted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "ok"],
      "properties": {
        "channel": { "type": "string", "maxLength": 20 },
        "ok": { "type": "boolean" },
        "why_not": { "type": "string", "maxLength": 300 }
      }
    },
    "limits": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 } },
    "ignored_instructions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "maxLength": 4000 }
  }
}
