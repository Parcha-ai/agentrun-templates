{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sprint.schema.json",
  "title": "Sprint check",
  "description": "Where one Linear team's current cycle stands: slipping issues, scope added after it started, linked pull requests that wait, and the Slack update that said so.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cycle", "slipping", "scope_added", "linked_prs", "still_flagged", "not_checked", "posted", "skipped", "ignored_instructions", "report_markdown"],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "title", "assignee", "reason"],
      "properties": {
        "identifier": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]+$" },
        "title": { "type": "string", "maxLength": 300 },
        "url": { "type": "string", "format": "uri" },
        "assignee": { "type": ["string", "null"], "maxLength": 100 },
        "kind": { "enum": ["overdue", "stalled", "not_started", "added"] },
        "since": { "type": ["string", "null"], "format": "date", "description": "the due date, last update or day it was added" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  },
  "properties": {
    "cycle": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "name", "starts_at", "ends_at", "day", "days_total", "done", "total"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": "string", "format": "date-time" },
        "day": { "type": "integer", "minimum": 1 },
        "days_total": { "type": "integer", "minimum": 1 },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "count_history": { "type": "string", "maxLength": 100, "description": "how the issue count moved, like \"8 to 9\"" }
      },
      "description": "null when the team has no current cycle"
    },
    "slipping": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/issue" } },
    "scope_added": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/issue" } },
    "linked_prs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "number", "url", "flag", "reason"],
        "properties": {
          "issue": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]+$" },
          "number": { "type": "integer", "minimum": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
          "flag": { "enum": ["no_review", "quiet", "merged_issue_open"] },
          "waiting_for": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 100 } },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "still_flagged": {
      "type": "array",
      "maxItems": 50,
      "description": "items the last check flagged for the same reason, unchanged since: id and reason only",
      "items": { "type": "string", "maxLength": 200 }
    },
    "not_checked": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 300 } },
    "posted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "ok"],
      "properties": {
        "channel": { "type": "string", "maxLength": 20 },
        "ok": { "type": "boolean" },
        "why_not": { "type": "string", "maxLength": 300 }
      }
    },
    "skipped": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "ignored_instructions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "maxLength": 8000 }
  }
}
