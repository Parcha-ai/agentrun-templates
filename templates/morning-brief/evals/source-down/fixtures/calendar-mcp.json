{
  "server": "googlecalendar",
  "description": "A fake Composio Google Calendar with no events on 2026-11-17.",
  "tools": {
    "GOOGLECALENDAR_EVENTS_LIST": {
      "description": "Returns events on the specified calendar.",
      "input": {
        "type": "object",
        "properties": {
          "calendarId": {
            "type": "string"
          },
          "timeMin": {
            "type": "string"
          },
          "timeMax": {
            "type": "string"
          },
          "singleEvents": {
            "type": "boolean"
          },
          "orderBy": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "maxResults": {
            "type": "integer"
          },
          "pageToken": {
            "type": "string"
          },
          "q": {
            "type": "string"
          },
          "showDeleted": {
            "type": "boolean"
          },
          "maxAttendees": {
            "type": "integer"
          },
          "eventTypes": {
            "type": "array"
          },
          "updatedMin": {
            "type": "string"
          }
        }
      },
      "answers": [],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\": {\"kind\": \"calendar#events\", \"timeZone\": \"UTC\", \"items\": []}, \"successful\": true, \"error\": null}"
          }
        ]
      }
    }
  }
}
