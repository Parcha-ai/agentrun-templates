{
  "server": "gmail",
  "description": "A fake Composio Gmail whose search finds nothing.",
  "tools": {
    "GMAIL_FETCH_EMAILS": {
      "description": "Fetches a list of email messages from a Gmail account, supporting filtering by Gmail search query.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "max_results": {
            "type": "integer"
          },
          "page_token": {
            "type": "string"
          },
          "include_payload": {
            "type": "boolean"
          },
          "label_ids": {
            "type": "array"
          },
          "include_spam_trash": {
            "type": "boolean"
          },
          "verbose": {
            "type": "boolean"
          },
          "ids_only": {
            "type": "boolean"
          }
        }
      },
      "answers": [],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\": {\"messages\": [], \"resultSizeEstimate\": 0}, \"successful\": true, \"error\": null}"
          }
        ]
      }
    },
    "GMAIL_FETCH_MESSAGE_BY_THREAD_ID": {
      "description": "Retrieves messages from a Gmail thread using its thread_id.",
      "input": {
        "type": "object",
        "properties": {
          "thread_id": {
            "type": "string"
          },
          "page_token": {
            "type": "string"
          }
        }
      },
      "answers": [],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\": {}, \"successful\": false, \"error\": \"Requested entity was not found.\"}"
          }
        ],
        "isError": true
      }
    }
  }
}
