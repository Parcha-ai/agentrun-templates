{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief.schema.json",
  "title": "Morning brief",
  "description": "One day's plan: what needs the owner, in what order, from their calendar, mail and Slack channels, each item linked to its source, and where it was posted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "timezone", "priorities", "schedule", "conflicts", "needs_you", "coverage", "delivery", "ignored_instructions", "report_markdown"],
  "$defs": {
    "link": { "type": "string", "format": "uri", "pattern": "^https://" }
  },
  "properties": {
    "date": { "type": "string", "format": "date" },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "priorities": {
      "type": "array",
      "maxItems": 3,
      "description": "the top items, most urgent first; fewer than three when fewer exist",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "why", "links"],
        "properties": {
          "action": { "type": "string", "minLength": 1, "maxLength": 300 },
          "why": { "type": "string", "minLength": 1, "maxLength": 300, "description": "the deadline, the person blocked or the meeting it prepares" },
          "due": { "type": ["string", "null"], "maxLength": 60 },
          "links": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/link" } }
        }
      }
    },
    "schedule": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "title", "status", "url"],
        "properties": {
          "start": { "type": "string", "maxLength": 40, "description": "HH:MM in the owner's zone, or all-day" },
          "end": { "type": "string", "maxLength": 40 },
          "title": { "type": "string", "maxLength": 300 },
          "status": { "enum": ["accepted", "tentative", "not_answered", "organizer", "all_day"] },
          "url": { "$ref": "#/$defs/link" },
          "prep": { "type": ["string", "null"], "maxLength": 400, "description": "what the event asks the owner to bring or read, quoted short; null when it asks nothing" },
          "conflict": { "type": "boolean" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["events", "overlap", "suggestion"],
        "properties": {
          "events": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "maxLength": 300 } },
          "overlap": { "type": "string", "maxLength": 60, "description": "the overlapping interval, HH:MM-HH:MM" },
          "suggestion": { "type": "string", "maxLength": 300, "description": "a suggestion only; nothing was accepted, declined or moved" }
        }
      }
    },
    "needs_you": {
      "type": "array",
      "maxItems": 40,
      "description": "every open item that needs the owner, ranked",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "from", "ask", "url", "kind", "carried"],
        "properties": {
          "source": { "enum": ["email", "slack", "calendar"] },
          "from": { "type": "string", "maxLength": 200, "description": "who asked: a name, and the channel for Slack" },
          "ask": { "type": "string", "minLength": 1, "maxLength": 400 },
          "kind": { "enum": ["ask", "suggestion"], "description": "ask: someone asked the owner; suggestion: the agent's own idea" },
          "due": { "type": ["string", "null"], "maxLength": 60, "description": "only a deadline the source states" },
          "url": { "$ref": "#/$defs/link" },
          "also_at": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/link" } },
          "related_meeting": { "type": ["string", "null"], "maxLength": 300 },
          "match": { "enum": ["clear", "maybe", "none"] },
          "carried": { "type": "boolean", "description": "true when an earlier plan already listed it and it is still open" },
          "first_asked": { "type": ["string", "null"], "maxLength": 40 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar", "mail", "slack", "channels_read", "channels_not_read"],
      "properties": {
        "calendar": { "enum": ["read", "failed"] },
        "mail": { "enum": ["read", "partial", "failed"] },
        "slack": { "enum": ["read", "partial", "failed"] },
        "channels_read": { "type": "array", "maxItems": 10, "items": { "type": "string" } },
        "channels_not_read": { "type": "array", "maxItems": 10, "items": { "type": "string" } },
        "mails_read": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["via", "to", "status"],
      "properties": {
        "via": { "const": "slack" },
        "to": { "type": "string" },
        "status": { "enum": ["posted", "failed"] },
        "error": { "type": "string", "maxLength": 300 }
      }
    },
    "ignored_instructions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "maxLength": 6000, "description": "the plan as posted" }
  }
}
