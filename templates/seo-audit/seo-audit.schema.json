{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seo-audit.schema.json",
  "title": "SEO audit",
  "description": "A technical and on-page SEO audit of one site: crawl checks, sampled pages, one Lighthouse run, Google rankings for the given keywords, and a prioritized fix list. Every finding names the page and the evidence; every score or position comes from a tool result in this run. What could not be checked is null or `unknown`, never guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["checked_on", "site", "bottom_line", "checks", "pages", "lighthouse", "rankings", "fixes", "gaps", "sources", "report_markdown"],
  "properties": {
    "checked_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "the run's date" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "audited_url", "reachable", "note"],
      "properties": {
        "requested": { "type": "string" },
        "audited_url": { "type": ["string", "null"], "description": "the home page's final URL after redirects; null when the site could not be reached" },
        "reachable": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 600, "description": "how the site was reached (fetched, or pages supplied in the message), http/https and www handling, any reading of the input" }
      }
    },
    "bottom_line": { "type": "string", "minLength": 1, "maxLength": 900, "description": "overall health, the issues costing the most, the single next step" },
    "checks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "check", "status", "evidence", "source"],
        "properties": {
          "area": { "enum": ["crawl", "indexing", "on_page", "structured_data", "speed", "rankings"] },
          "check": { "type": "string", "maxLength": 160 },
          "status": { "enum": ["pass", "warn", "fail", "unknown"] },
          "evidence": { "type": "string", "maxLength": 400, "description": "what was seen, quoted or measured; for unknown, why it could not be checked" },
          "source": { "type": "string", "description": "a source id (S1) from `sources`" }
        }
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "meta_description", "h1_count", "canonical", "indexable", "structured_data", "issues", "source"],
        "properties": {
          "url": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "meta_description": { "type": ["string", "null"] },
          "h1_count": { "type": ["integer", "null"], "minimum": 0 },
          "canonical": { "type": ["string", "null"] },
          "indexable": { "type": ["boolean", "null"], "description": "false when a noindex tag, a robots.txt block or a canonical to another host keeps it out" },
          "structured_data": { "type": "array", "maxItems": 8, "items": { "type": "string" }, "description": "schema.org types found in JSON-LD or microdata" },
          "onpage_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "the page check's own 0-100 score, when it ran" },
          "issues": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 200 } },
          "source": { "type": "string" }
        }
      }
    },
    "lighthouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ran", "url", "performance", "seo", "top_issues", "note", "source"],
      "properties": {
        "ran": { "type": "boolean" },
        "url": { "type": ["string", "null"] },
        "device": { "enum": ["mobile", "desktop", null] },
        "performance": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "seo": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "lcp_ms": { "type": ["number", "null"] },
        "cls": { "type": ["number", "null"] },
        "top_issues": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["audit", "detail"],
            "properties": { "audit": { "type": "string" }, "detail": { "type": "string", "maxLength": 300 } }
          }
        },
        "note": { "type": "string", "maxLength": 400, "description": "lab data from one run; or why it did not run" },
        "source": { "type": ["string", "null"] }
      }
    },
    "rankings": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyword", "location", "position", "ranking_url", "leaders", "source"],
        "properties": {
          "keyword": { "type": "string" },
          "location": { "type": "string" },
          "position": { "type": ["integer", "null"], "minimum": 1, "description": "the site's best organic position on Google's first page; null when it is not there" },
          "ranking_url": { "type": ["string", "null"] },
          "leaders": { "type": "array", "maxItems": 3, "items": { "type": "string" }, "description": "the domains in positions 1 to 3" },
          "source": { "type": "string" }
        }
      }
    },
    "fixes": {
      "type": "array",
      "maxItems": 12,
      "description": "highest impact for the effort first",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "fix", "pages", "evidence", "why", "impact", "effort", "owner", "source"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "fix": { "type": "string", "maxLength": 300 },
          "pages": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
          "evidence": { "type": "string", "maxLength": 400 },
          "why": { "type": "string", "maxLength": 300 },
          "impact": { "enum": ["high", "medium", "low"] },
          "effort": { "enum": ["high", "medium", "low"] },
          "owner": { "enum": ["dev", "content", "marketing"] },
          "source": { "type": "string" }
        }
      }
    },
    "gaps": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 400 } },
    "sources": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "where", "what", "found"],
        "properties": {
          "id": { "type": "string", "pattern": "^S\\d+$" },
          "where": { "type": "string", "description": "the URL fetched, or the tool and its main argument (monid:dataforseo/onpage/lighthouse https://site/)" },
          "what": { "type": "string", "maxLength": 200 },
          "found": { "type": "boolean", "description": "false when the fetch or call failed or returned nothing" }
        }
      }
    },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "description": "the audit a person reads: bottom line, fix list, then the checks, pages, Lighthouse and rankings" }
  }
}
