{
  "server": "slack",
  "description": "A fake Composio Slack toolkit. Its one tool is shaped as Composio's SLACK_SEND_MESSAGE (channel, markdown_text, ...; answers in the {data, successful, error} envelope). A post to C0SALES001 succeeds; a post anywhere else answers channel_not_found, so a stray post shows in the recorded calls. It never reaches Slack.",
  "tools": {
    "SLACK_SEND_MESSAGE": {
      "description": "Posts a message to a Slack channel; content in `markdown_text` or `blocks`.",
      "input": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "ID or name of the channel to send the message to."
          },
          "markdown_text": {
            "type": "string",
            "description": "Message written in markdown."
          },
          "blocks": {
            "type": "array"
          },
          "thread_ts": {
            "type": "string"
          },
          "unfurl_links": {
            "type": "boolean"
          }
        },
        "required": [
          "channel"
        ]
      },
      "answers": [
        {
          "when": {
            "channel": "C0SALES001"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\":{\"ok\":true,\"channel\":\"C0SALES001\",\"ts\":\"1763110800.000100\",\"message\":{\"type\":\"message\",\"ts\":\"1763110800.000100\",\"text\":\"posted\"}},\"successful\":true,\"error\":null}"
              }
            ]
          }
        }
      ],
      "default": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{},\"successful\":false,\"error\":\"channel_not_found\"}"
          }
        ]
      }
    }
  }
}
