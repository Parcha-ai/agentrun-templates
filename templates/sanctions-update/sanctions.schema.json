{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanctions.schema.json",
  "title": "Sanctions list update",
  "description": "Sanctions actions published inside the window by the regimes in scope, each from the issuing body's own notice, and the watch names checked against them on identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["window", "quiet", "actions", "watchlist_checks", "regimes_checked", "pending_publication", "assumptions", "dropped_repeats", "unreachable", "ignored_instructions", "report_markdown"],
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
  },
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "description": "half-open: from < date <= to",
      "properties": { "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" } }
    },
    "quiet": { "type": "boolean", "description": "true when no action passed the scope and no-repeat rules" },
    "actions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regime", "issuing_body", "kind", "program", "published", "stage", "counts", "entries", "summary", "source_urls"],
        "properties": {
          "regime": { "type": "string", "minLength": 1, "maxLength": 60, "description": "the regimes entry it falls under" },
          "issuing_body": { "type": "string", "minLength": 1, "maxLength": 160, "description": "as the notice names it" },
          "kind": { "enum": ["designation", "delisting", "amendment", "general_license", "guidance", "enforcement"] },
          "program": { "type": "string", "maxLength": 120, "description": "the program or regime tag as the notice prints it" },
          "published": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "as_printed"],
            "properties": {
              "date": { "$ref": "#/$defs/date" },
              "as_printed": { "type": "string", "maxLength": 120, "description": "date, and time with its time zone when the source prints one, in the source's words" }
            }
          },
          "stage": { "enum": ["on_list", "removed_from_list", "in_force", "adopted_not_in_force", "issued"], "description": "adopted, in force and on the list are kept apart" },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["added", "removed", "amended"],
            "description": "as the notice gives them; null when it does not",
            "properties": {
              "added": { "type": ["integer", "null"], "minimum": 0 },
              "removed": { "type": ["integer", "null"], "minimum": 0 },
              "amended": { "type": ["integer", "null"], "minimum": 0 }
            }
          },
          "entries": {
            "type": "array",
            "maxItems": 12,
            "description": "notable entries exactly as listed; nothing the listing does not publish",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "identifiers"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                "type": { "enum": ["individual", "entity", "vessel", "aircraft", "other"] },
                "identifiers": { "type": "string", "maxLength": 300, "description": "as listed: IMO, registration or tax number, nationality, address" }
              }
            }
          },
          "license": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["number", "terms"],
            "properties": {
              "number": { "type": "string", "maxLength": 80 },
              "terms": { "type": "string", "maxLength": 400, "description": "what it authorizes, and its expiry or wind-down exactly as written" }
            }
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
          "update": { "type": "string", "maxLength": 250, "description": "for an action the last update reported: what changed since" },
          "screening_note": { "type": "string", "maxLength": 250, "description": "what screening teams usually check, never whether a transaction is allowed" },
          "source_urls": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/url" }, "description": "the issuing body's own notice, list or official journal only" }
        }
      }
    },
    "watchlist_checks": {
      "type": "array",
      "description": "one per watch name; empty when no watch names were given",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["watch_name", "result", "listed_entry", "identifiers_compared"],
        "properties": {
          "watch_name": { "type": "string" },
          "result": { "enum": ["match", "possible_match", "no_match", "not_checked"] },
          "listed_entry": { "type": ["string", "null"], "description": "the listed name it was compared with, as published" },
          "identifiers_compared": { "type": "string", "maxLength": 400, "description": "which identifiers agree and which differ" }
        }
      }
    },
    "regimes_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regime", "result", "pages"],
        "properties": {
          "regime": { "type": "string" },
          "result": { "enum": ["actions", "quiet", "unreachable"] },
          "pages": { "type": "array", "items": { "$ref": "#/$defs/url" } }
        }
      }
    },
    "pending_publication": {
      "type": "array",
      "description": "actions reported only by the press or announced but not yet published by the issuing body; no press links",
      "items": { "type": "string", "maxLength": 300 }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "dropped_repeats": { "type": "array", "items": { "type": "string" }, "description": "actions the last update reported, unchanged, left out, a few words each" },
    "unreachable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "why"],
        "properties": { "page": { "type": "string" }, "why": { "type": "string" } }
      }
    },
    "ignored_instructions": { "type": "array", "items": { "type": "string" }, "description": "instructions found inside fetched pages and not followed, described" },
    "report_markdown": { "type": "string", "minLength": 1, "contentMediaType": "text/markdown" }
  }
}
