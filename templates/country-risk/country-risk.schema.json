{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "country-risk.schema.json",
  "title": "Country risk check",
  "description": "A sourced risk profile of one country. Every fact carries the ids of the sources it rests on (S1, S2, ...), each listed in `sources`, with its edition or date. A status that could not be confirmed at its primary source says so.",
  "type": "object",
  "additionalProperties": false,
  "required": ["checked_on", "country", "rating", "rating_reason", "context_focus", "sanctions", "indicators", "political_and_payment", "controls", "open_questions", "gaps", "sources", "report_markdown"],
  "properties": {
    "checked_on": { "$ref": "#/$defs/date" },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "interpretation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "other_names": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
        "interpretation": { "type": "string", "maxLength": 500, "description": "how the country, territory, context and regimes were read" }
      }
    },
    "rating": { "enum": ["low", "medium", "high", "prohibitive", "not_rated"], "description": "an assessment; not_rated when the country could not be identified" },
    "rating_reason": { "type": "string", "minLength": 1, "maxLength": 400 },
    "context_focus": { "type": "string", "maxLength": 300, "description": "which context emphasis applies (supplier payments, customer onboarding, market entry, general) and why" },
    "sanctions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regime", "program", "scope", "status", "sources"],
        "properties": {
          "regime": { "type": "string", "maxLength": 60 },
          "program": { "type": ["string", "null"], "maxLength": 200, "description": "the program's name, or null when none exists" },
          "scope": { "enum": ["comprehensive", "sectoral", "targeted", "none_found", "unconfirmed"] },
          "legal_basis": { "type": ["string", "null"], "maxLength": 300, "description": "the executive order, regulation or decision, as the source names it" },
          "key_limits": { "type": ["string", "null"], "maxLength": 400 },
          "last_amended": { "type": ["string", "null"] },
          "status": { "type": "string", "maxLength": 300, "description": "what the primary source says, or that it was unreachable" },
          "sources": { "$ref": "#/$defs/source_ids" }
        }
      }
    },
    "indicators": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indicator", "value", "edition", "stale", "sources"],
        "properties": {
          "indicator": { "type": "string", "maxLength": 80, "description": "FATF lists, EU high-risk third countries, Basel AML Index, TI CPI, WGI, ..." },
          "value": { "type": ["string", "null"], "maxLength": 200, "description": "status or score and rank; null when not found" },
          "edition": { "type": ["string", "null"], "maxLength": 60, "description": "edition year or plenary date" },
          "published": { "type": ["string", "null"] },
          "stale": { "type": "boolean", "description": "true when published more than 12 months before checked_on" },
          "sources": { "$ref": "#/$defs/source_ids" }
        }
      }
    },
    "political_and_payment": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "finding", "sources"],
        "properties": {
          "topic": { "enum": ["stability_conflict", "capital_controls", "fx_availability", "repatriation", "payment_rails", "correspondent_banking", "data_localization", "other"] },
          "finding": { "type": "string", "maxLength": 500, "description": "dated, cited; assessment labeled" },
          "date": { "type": ["string", "null"] },
          "sources": { "$ref": "#/$defs/source_ids" }
        }
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control", "level", "tied_to"],
        "properties": {
          "control": { "type": "string", "maxLength": 300 },
          "level": { "enum": ["baseline", "enhanced"] },
          "tied_to": { "type": "string", "maxLength": 200, "description": "the finding it answers" }
        }
      }
    },
    "open_questions": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 }, "description": "what could not be confirmed, what needs counsel or the bank, what to monitor and when" },
    "gaps": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 400 } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "found"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "title": { "type": "string" },
          "publisher": { "type": ["string", "null"] },
          "url": { "type": "string" },
          "published": { "type": ["string", "null"] },
          "found": { "type": "boolean" }
        }
      }
    },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "description": "the profile as Markdown, citing sources inline as [S1]" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source_ids": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]+$" } }
  }
}
