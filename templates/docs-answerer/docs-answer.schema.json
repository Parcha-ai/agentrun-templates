{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs-answer.schema.json",
  "title": "Answer from the docs",
  "description": "An answer to one question taken only from one documentation site, each point citing the docs pages (D1, D2, ...) that say it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "docs_scope", "status", "answer", "points", "not_covered", "pages", "searches", "ignored_instructions", "report_markdown"],
  "properties": {
    "question": { "type": "string", "minLength": 1, "maxLength": 800, "description": "the question as you read it" },
    "docs_scope": { "type": "string", "maxLength": 300, "description": "the host and path prefix that counted as the docs: docs.python.org/3/" },
    "status": { "enum": ["answered", "partly_answered", "not_in_docs", "could_not_read"], "description": "not_in_docs: the docs pages you read don't answer it; could_not_read: no docs page could be read" },
    "answer": { "type": "string", "minLength": 1, "maxLength": 1500, "description": "the answer in two to six sentences with [D1] citations; when the docs don't answer it, says so" },
    "points": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "sources", "quote"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 400 },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^D[0-9]+$" } },
          "quote": { "type": "string", "minLength": 1, "maxLength": 300, "description": "the docs' own words this point rests on, copied" }
        }
      }
    },
    "not_covered": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "where_looked"],
        "properties": {
          "item": { "type": "string", "maxLength": 300, "description": "the part of the question the docs you read don't answer" },
          "where_looked": { "type": "string", "maxLength": 300, "description": "the docs pages and searches checked" }
        }
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^D[0-9]+$" },
          "url": { "type": "string", "format": "uri", "description": "a docs page you read in this run" },
          "title": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "searches": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 300 }, "description": "each search query you ran, as run" },
    "ignored_instructions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["where", "asked"],
        "properties": {
          "where": { "type": "string", "maxLength": 300 },
          "asked": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "maxLength": 6000, "description": "the answer for a person, with [D1] citations and the pages listed with their URLs" }
  }
}
