{
  "server": "slack",
  "description": "A fake Composio Slack. A post to C0SUPPORT1 succeeds; any other channel answers channel_not_found.",
  "tools": {
    "SLACK_SEND_MESSAGE": {
      "description": "Posts a message to a Slack channel, direct message, or private group.",
      "input": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "markdown_text": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "thread_ts": {
            "type": "string"
          },
          "blocks": {
            "type": "array"
          },
          "unfurl_links": {
            "type": "boolean"
          },
          "mrkdwn": {
            "type": "boolean"
          }
        }
      },
      "answers": [
        {
          "when": {
            "channel": "C0SUPPORT1"
          },
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"data\": {\"ok\": true, \"channel\": \"C0SUPPORT1\", \"ts\": \"1795251600.000100\"}, \"successful\": true, \"error\": null}"
              }
            ]
          }
        }
      ],
      "default": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\": {}, \"successful\": false, \"error\": \"channel_not_found\"}"
          }
        ],
        "isError": true
      }
    }
  }
}
