{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terms-changes.schema.json",
  "title": "Terms change watch",
  "description": "Clause-level changes to the watched legal pages since the last check, each with the old and new wording and where the old wording came from.",
  "type": "object",
  "additionalProperties": false,
  "required": ["window", "quiet", "changes", "documents_checked", "assumptions", "dropped_repeats", "unreachable", "ignored_instructions", "report_markdown"],
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
  },
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "description": "from: the last check's date (or today minus lookback_days); to: today",
      "properties": { "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" } }
    },
    "quiet": { "type": "boolean", "description": "true when no confirmed change passed the noise and no-repeat rules" },
    "changes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vendor", "document", "page_url", "clause", "kind", "summary", "before", "after", "before_source", "confirmed", "version_date", "effective", "so_what", "source_urls"],
        "properties": {
          "vendor": { "type": "string", "minLength": 1, "maxLength": 120 },
          "document": { "enum": ["terms", "privacy_policy", "dpa", "aup", "subprocessors", "other"] },
          "page_url": { "$ref": "#/$defs/url" },
          "clause": { "type": "string", "minLength": 1, "maxLength": 80, "description": "the section or clause number exactly as the live page numbers it, with its heading" },
          "kind": { "enum": ["obligation", "right", "definition", "liability", "fee", "notice_period", "governing_law", "subprocessors", "data_use", "retention", "termination", "effective_date", "other"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
          "before": { "type": ["string", "null"], "maxLength": 800, "description": "the old wording, quoted exactly and briefly; null for an added clause or when no earlier text was retrieved" },
          "after": { "type": ["string", "null"], "maxLength": 800, "description": "the live wording, quoted exactly and briefly; null for a removed clause" },
          "before_source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date"],
            "properties": {
              "kind": { "enum": ["learned_note", "last_run", "vendor_history", "archive", "none"] },
              "date": { "type": ["string", "null"], "format": "date", "description": "the date the earlier text was seen or captured" },
              "url": { "type": ["string", "null"], "description": "the archive capture or vendor history URL, when the old text came from one" }
            }
          },
          "confirmed": { "type": "boolean", "description": "false only when no earlier text was retrieved: the summary then starts 'Unconfirmed: prior version not retrieved'" },
          "version_date": { "type": ["string", "null"], "maxLength": 80, "description": "the page's own 'last updated' or version stamp, as written" },
          "effective": { "type": "string", "minLength": 1, "maxLength": 120, "description": "the effective date as the page states it, or 'effective date not stated'" },
          "vendor_claim": { "type": ["string", "null"], "maxLength": 300, "description": "the vendor's own characterisation of the update, quoted and labelled as theirs" },
          "change_since_last": { "type": "string", "maxLength": 200, "description": "for a change the last run reported: what developed since" },
          "so_what": { "type": "string", "minLength": 1, "maxLength": 300, "description": "what to review, check or calendar with counsel; never legal advice" },
          "source_urls": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/url" }, "description": "the live page first, then the earlier version's URL" }
        }
      }
    },
    "documents_checked": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "result"],
        "properties": {
          "document": { "type": "string", "maxLength": 200, "description": "the entry as watched" },
          "page_url": { "type": ["string", "null"], "maxLength": 500 },
          "version_date": { "type": ["string", "null"], "maxLength": 80 },
          "result": { "enum": ["changed", "unchanged", "no_baseline", "unreachable", "unresolved"] },
          "noise_ignored": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 200 } }
        }
      }
    },
    "assumptions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "dropped_repeats": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 300 } },
    "unreachable": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "reason"],
        "properties": {
          "url": { "type": "string", "maxLength": 500 },
          "reason": { "enum": ["blocked", "rate_limited", "not_found", "error", "skipped"] },
          "detail": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "ignored_instructions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "maxLength": 12000 }
  }
}
