{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enrich.schema.json",
  "title": "Sheet row enrichment",
  "description": "What the agent did with one new Google Sheets row: the blank cells it filled with sourced facts about the company, the cells it left blank and why, and the one write it made, or why it left the row alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["row", "action", "filled", "left_blank", "already_filled", "write", "searches", "ignored_instructions", "skipped", "limits", "report_markdown"],
  "properties": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab", "number", "company"],
      "properties": {
        "tab": { "type": ["string", "null"], "maxLength": 100 },
        "number": { "type": ["integer", "null"], "minimum": 2 },
        "company": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "action": { "enum": ["filled", "nothing_found", "lookup_failed", "skipped"], "description": "nothing_found: the lookups answered and no value could be sourced; lookup_failed: the searches or fetches errored, so nothing could be checked" },
    "filled": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column", "cell", "value", "source"],
        "properties": {
          "column": { "type": "string", "maxLength": 60 },
          "cell": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,7}$" },
          "value": { "type": "string", "maxLength": 1000 },
          "source": { "type": ["string", "null"], "format": "uri", "maxLength": 500, "description": "null only for the sources cell itself" }
        }
      }
    },
    "left_blank": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column", "why"],
        "properties": {
          "column": { "type": "string", "maxLength": 60 },
          "cell": { "type": ["string", "null"], "pattern": "^[A-Z]{1,3}[0-9]{1,7}$" },
          "why": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "already_filled": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 60 }, "description": "listed columns whose cell had a value, left as it was" },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "ranges"],
      "properties": {
        "ok": { "type": "boolean", "description": "false when no write was made or it failed" },
        "ranges": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 140 } },
        "why_not": { "type": "string", "maxLength": 300 }
      }
    },
    "searches": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "ignored_instructions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "skipped": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "limits": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "report_markdown": { "type": "string", "contentMediaType": "text/markdown", "minLength": 1, "maxLength": 3000 }
  }
}
